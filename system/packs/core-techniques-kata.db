{"_id":"L5RCoreKat000025","name":"Iron Forest Style","permission":{"default":0},"type":"technique","data":{"in_curriculum":false,"xp_used":0,"rank":"2","bought_at_rank":0,"ring":"void","technique_type":"kata","effects":"<i class=\"i_opportunity\" title=\"\"></i>+: The area in range of your weapon counts as Dangerous terrain for one target of your action per <i class=\"i_opportunity\" title=\"\"></i> spent this way. When an affected character attempts to move closer to you, they must make a TN 4 Fitness check (Air 2, Water 5); if they fail, they cannot advance. This effect persists until the start of your next turn.","xp_cost":"3","description":"","book_reference":"Core p.180"},"sort":100001,"flags":{},"img":"systems/l5r5e/assets/icons/techs/kata.svg","effects":[]}
{"_id":"L5RCoreKat000026","name":"Open-Hand Style","permission":{"default":0},"type":"technique","data":{"in_curriculum":false,"xp_used":0,"rank":"2","bought_at_rank":0,"ring":"void","technique_type":"kata","effects":"<i class=\"i_opportunity\" title=\"\"></i><i class=\"i_opportunity\" title=\"\"></i>+: One target of your action per <i class=\"i_opportunity\" title=\"\"></i><i class=\"i_opportunity\" title=\"\"></i> spent this way must switch to a different stance of your choice. Targets of silhouette 3 or greater may resist with a TN 3 Fitness check and ignore this effect if they succeed.","xp_cost":"3","description":"","book_reference":"Core p.180"},"sort":100001,"flags":{},"img":"systems/l5r5e/assets/icons/techs/kata.svg","effects":[]}
