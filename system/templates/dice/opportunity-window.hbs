<section class="opportunity-window-content {{mode}}" aria-live="polite">
    <header class="opportunity-window-budget">
        <span><i class="i_opportunity" aria-hidden="true"></i> {{localize "l5r5e.automation.opportunity.generated"}}: <strong>{{budget.generated}}</strong></span>
        {{#if spendMode}}
        <span>{{localize "l5r5e.automation.opportunity.spent"}}: <strong>{{budget.spent}}</strong></span>
        <span>{{localize "l5r5e.automation.opportunity.remaining"}}: <strong>{{budget.remaining}}</strong></span>
        {{/if}}
    </header>

    {{#if errors.length}}
    <div class="opportunity-errors" role="alert">
        {{#each errors}}<p><i class="fas fa-triangle-exclamation" aria-hidden="true"></i> {{this}}</p>{{/each}}
    </div>
    {{/if}}

    <div class="opportunity-list">
        {{#each opportunities}}
        <article class="opportunity-row {{#unless reachable}}unreachable{{/unless}}" data-rules-key="{{rulesKey}}">
            <div class="opportunity-entry-grid {{#if ../spendMode}}with-spend-control{{/if}}">
                {{#if ../spendMode}}
                <div class="opportunity-spend-control">
                    {{#if cost.scalable}}
                    <div class="opportunity-counter" role="group" aria-label="{{name}}">
                        <button type="button" data-opportunity-adjust="{{rulesKey}}" data-delta="-1" aria-label="−">−</button>
                        <output>{{selectedSpend}}</output>
                        <button type="button" data-opportunity-adjust="{{rulesKey}}" data-delta="1" aria-label="+">+</button>
                    </div>
                    {{else}}
                    <label><input type="checkbox" data-opportunity-toggle="{{rulesKey}}" {{checked selected}} {{#unless reachable}}disabled{{/unless}}> {{localize "l5r5e.automation.opportunity.spend"}}</label>
                    {{/if}}
                </div>
                {{/if}}

                <div class="opportunity-details">
                    <header>
                        <i class="i_{{ring}}" aria-hidden="true"></i>
                        <strong>{{name}}</strong>
                        <span class="opportunity-cost">{{cost.base}}{{#if cost.scalable}}+{{/if}} <i class="i_opportunity" aria-hidden="true"></i></span>
                        <span class="opportunity-reachability">{{#if reachable}}{{localize "l5r5e.automation.opportunity.reachable"}}{{else}}{{localize "l5r5e.automation.opportunity.unreachable"}}{{/if}}</span>
                    </header>
                    <p>{{description}}</p>
                    <small>{{sourceReference.source}} {{sourceReference.page}} · {{automation}}</small>
                </div>

                {{#if ../spendMode}}
                <div class="opportunity-decision-column">
                    <div class="opportunity-decisions">
                        {{#if conditionChoice}}
                        <label>{{localize "l5r5e.automation.opportunity.condition"}} <select data-opportunity-decision="{{rulesKey}}" data-field="condition"><option value="">—</option>{{selectOptions conditions selected=selectedCondition valueAttr="value" labelAttr="label"}}</select></label>
                        {{/if}}
                        {{#if ringChoice}}
                        <label>{{localize "l5r5e.automation.opportunity.ring"}} <select data-opportunity-decision="{{rulesKey}}" data-field="ring"><option value="">—</option>{{selectOptions rings selected=selectedRing valueAttr="value" labelAttr="label"}}</select></label>
                        {{/if}}
                        {{#if targetChoice}}
                        <label>{{localize "l5r5e.automation.opportunity.target"}} <select data-opportunity-decision="{{rulesKey}}" data-field="{{#if multipleTargets}}targetUuids{{else}}targetUuid{{/if}}" {{#if multipleTargets}}multiple{{/if}}><option value="">—</option>{{selectOptions targetChoices selected=selectedTargetUuid valueAttr="value" labelAttr="label"}}</select></label>
                        {{/if}}
                    </div>
                </div>
                {{/if}}
            </div>
        </article>
        {{/each}}
    </div>

    {{#if spendMode}}
    <footer><button type="button" data-opportunity-confirm {{#unless valid}}disabled{{/unless}}><i class="fas fa-check" aria-hidden="true"></i> {{localize "l5r5e.automation.opportunity.confirm"}}</button></footer>
    {{/if}}
</section>
