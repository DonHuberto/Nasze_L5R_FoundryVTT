    "devDependencies": {
        "babel-eslint": "^10.1.0",
        "browser-sync": "^2.26.13",
        "eslint": "^7.15.0",
        "eslint-config-prettier": "^6.15.0",
        "eslint-plugin-prettier": "^3.1.4",
        "foundry-pc-types": "gitlab:foundry-projects/foundry-pc/foundry-pc-types",
        "gulp": "^4.0.2",
        "gulp-autoprefixer": "^7.0.1",
